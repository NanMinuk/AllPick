# OpenAI API Key (필수)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-...

# 네이버 쇼핑 검색 API (크롤링 시 필요, 서버 실행엔 불필요)
# https://developers.naver.com/apps 에서 발급 (검색 API 권한 필요)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# MongoDB (가족 프로필 저장)
# https://www.mongodb.com/cloud/atlas 에서 무료 클러스터 생성
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/allpick

# LangFuse 모니터링 (선택)
# https://langfuse.com 에서 발급
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# 서버 포트 (기본값: 4000)
PORT=4000
